# Wszystkie zmienne sa opcjonalne - bez nich backend dziala na lokalnej bazie H2.
# Port serwera (domyslnie 8080)
PORT=8080
# Katalog z plikiem bazy (domyslnie backend/data)
DATA_DIR=./data
# Adresy frontu dopuszczone przez CORS (domyslnie wszystkie; w sieci lokalnej statku tak ma byc)
CORS_ORIGINS=*
