# Bez tych zmiennych backend startuje na lokalnym H2 (plik backend/data).
# Postgres (Neon/Supabase): format JDBC, nie postgres://
DATABASE_URL=jdbc:postgresql://HOST:5432/DB?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=
# Adresy frontu dopuszczone przez CORS (tylko gdy front wola backend bezposrednio)
CORS_ORIGINS=http://localhost:3000
