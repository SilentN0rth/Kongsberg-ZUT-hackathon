# Frontend + Payload CMS (ten sam proces Next.js)
# Sekret do podpisywania sesji logowania. Wygeneruj własny: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=zmien-na-dlugi-losowy-ciag
# Lokalna baza SQLite (plik). Katalog data/ jest w .gitignore. Kopia zapasowa = skopiowanie pliku przy zatrzymanej aplikacji.
DATABASE_URI=file:./data/watchbrief.db
# Opcjonalnie: stary backend Spring Boot (backend/), dostępny pod /legacy-api/*
BACKEND_URL=http://localhost:8080
# Narzędzia demo w panelu (wczytywanie scenariuszy KASUJE dane). Domyślnie włączone tylko poza produkcją.
WATCHBRIEF_DEMO_TOOLS=true
# Strefa czasowa briefu zmiany
WATCHBRIEF_TIMEZONE=Europe/Warsaw
